# Model provider: anthropic, deepseek, dashscope, openai, or ollama
AGENTSCOPE_MODEL_PROVIDER=anthropic
AGENTSCOPE_MODEL_NAME=claude-opus-4-8
AGENTSCOPE_MODEL_STREAM=true
AGENTSCOPE_MAX_ITERS=20

# Set the credential for the selected provider.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=
OLLAMA_HOST=http://localhost:11434

# BabyBuddy MCP uses Streamable HTTP at this endpoint.
BABYBUDDY_MCP_URL=http://192.168.5.13:2001/mcp
BABYBUDDY_MCP_TIMEOUT=30
BABYBUDDY_MCP_STATEFUL=true
BABYBUDDY_MCP_ENABLE_TOOLS=
BABYBUDDY_MCP_DISABLE_TOOLS=
BABYBUDDY_MCP_ALLOWED_HOSTS=192.168.5.13,localhost,127.0.0.1
# Server-side Baby Buddy origin used to proxy /media images to the browser.
# This must be reachable from the Home Jarvis backend, not from the browser.
BABYBUDDY_MEDIA_URL=http://baby.home
BABYBUDDY_USER_NAME=user
BABYBUDDY_AUDIT_PATH=var/audit/events.jsonl

# Read-only exercise catalog. The agent never reads workout/user tables.
DATABASE_URL=postgresql://postgres:123456@192.168.5.13:5432/ExerciseDB

# Mobile web service: keep the password and signing secret on the server only.
# The session signing secret must contain at least 4 characters; use a longer random value outside local development.
AGENT_WEB_HOST=0.0.0.0
AGENT_WEB_PORT=8000
# Docker host port. The container always listens on 8000.
HOME_JARVIS_PORT=18080
AGENT_WEB_PASSWORD=
AGENT_WEB_SESSION_SECRET=
# Local development keeps runtime data under var/. Docker Compose overrides this to /data.
AGENT_WEB_DATABASE_PATH=var/agent-web.sqlite3
AGENT_WEB_CONFIRMATION_TTL=300
# For Vite development, set http://localhost:5173; Docker Compose clears this for its same-origin Nginx proxy.
AGENT_WEB_ALLOWED_ORIGINS=http://localhost:5173
# Extra exact AgentScope tool names that are safe for GET /api/today.
# Standard list/get/retrieve/search tool names are allowed automatically.
AGENT_WEB_READ_TOOL_ALLOWLIST=

# Home Assistant uses this separate shared token for POST /chat (or /api/ha/chat).
# Send it in Authorization: Bearer <token> or X-Agent-HA-Token. Do not reuse the web password.
AGENT_HA_TOKEN=
# Used when Home Assistant does not include an IANA timezone in the request.
AGENT_HA_TIMEZONE=Asia/Shanghai
